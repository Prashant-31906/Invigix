<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/css/output.css" rel="stylesheet">
    <title><%= title %></title>
</head>
<body class="bg-gray-100">
    <nav class="bg-blue-600 p-4 text-white flex justify-between items-center">
        <h1 class="text-xl font-bold">Admin Panel (EMS)</h1>
        <div><span class="mr-4">Welcome, <%= user.username %>!</span><a href="/logout" class="py-2 px-4 bg-red-500 rounded hover:bg-red-600">Logout</a></div>
    </nav>

    <div class="container mx-auto p-8">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-3xl font-semibold">Manage Faculty Availability</h2>
        </div>
        
        <div class="bg-white shadow-md rounded-lg overflow-x-auto">
            <table class="min-w-full">
                <thead class="bg-gray-200">
                    <tr>
                        <th class="py-3 px-6 text-left">Name</th>
                        <th class="py-3 px-6 text-left">Username</th>
                        <th class="py-3 px-6 text-left">Department</th>
                        <th class="py-3 px-6 text-center">Status</th>
                        <th class="py-3 px-6 text-center">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    <% faculty.forEach(f => { %>
                        <tr class="hover:bg-gray-50">
                            <td class="py-4 px-6"><%= f.name || '-' %></td>
                            <td class="py-4 px-6"><%= f.username %></td>
                            <td class="py-4 px-6"><%= f.department || '-' %></td>
                            <td class="py-4 px-6 text-center">
                                <% if (f.availability_status) { %>
                                    <span class="px-3 py-1 text-sm font-semibold text-green-800 bg-green-200 rounded-full">Available</span>
                                <% } else { %>
                                    <span class="px-3 py-1 text-sm font-semibold text-red-800 bg-red-200 rounded-full">On Leave</span>
                                <% } %>
                            </td>
                            <td class="py-4 px-6 text-center">
                                <form action="/admin/faculty/toggle/<%= f.id %>" method="POST">
                                    <% if (f.availability_status) { %>
                                        <input type="hidden" name="status" value="false">
                                        <button type="submit" class="text-red-600 hover:text-red-800">Mark as On Leave</button>
                                    <% } else { %>
                                        <input type="hidden" name="status" value="true">
                                        <button type="submit" class="text-green-600 hover:text-green-800">Mark as Available</button>
                                    <% } %>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <a href="/admin/dashboard" class="inline-block mt-6 text-blue-600 hover:underline">&larr; Back to Dashboard</a>
    </div>
</body>
</html>