<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/css/output.css" rel="stylesheet">
    <title><%= title %></title>
</head>
<body class="bg-gray-100">

    <nav class="bg-blue-600 p-4 text-white flex justify-between items-center">
        <h1 class="text-xl font-bold">Admin Panel (EMS)</h1>
        <div>
            <span class="mr-4">Welcome, <%= user.username %>!</span>
            <a href="/logout" class="py-2 px-4 bg-red-500 rounded hover:bg-red-600">Logout</a>
        </div>
    </nav>

    <div class="container mx-auto p-8">
        <h2 class="text-3xl font-semibold mb-6">Admin Dashboard</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <a href="/admin/students" class="block p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow">
                <h3 class="text-xl font-bold text-blue-700 mb-2">Manage Students</h3>
                <p class="text-gray-600">Add, Edit, or Remove students.</p>
            </a>
            
            <a href="/admin/classrooms" class="block p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow">
                <h3 class="text-xl font-bold text-blue-700 mb-2">Manage Classrooms</h3>
                <p class="text-gray-600">Define rooms and their capacity.</p>
            </a>
            
            <a href="/admin/exams" class="block p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow">
                <h3 class="text-xl font-bold text-blue-700 mb-2">Manage Exams</h3>
                <p class="text-gray-600">Schedule exams and subjects.</p>
            </a>


            <a href="/admin/faculty" class="block p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow">
                <h3 class="text-xl font-bold text-yellow-700 mb-2">Manage Faculty</h3>
                <p class="text-gray-600">View faculty list and manage their availability status.</p>
            </a>

            
             <a href="/admin/seating-plan" class="block p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow md:col-span-3">
                <h3 class="text-xl font-bold text-green-700 mb-2">Generate Seating Plan</h3>
                <p class="text-gray-600">Automated seating arrangement algorithm ko run karein aur plan generate karein.</p>
            </a>
            <a href="/admin/invigilation" class="block p-6 bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow">
                <h3 class="text-xl font-bold text-purple-700 mb-2">Generate Invigilation Roster</h3>
                <p class="text-gray-600">Automatically assign invigilation duties to available faculty.</p>
            </a>
        </div>
    </div>

</body>
</html>