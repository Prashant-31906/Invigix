<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/css/output.css" rel="stylesheet">
    <title><%= title %></title>
</head>
<body class="bg-gray-100">
    <nav class="bg-blue-600 p-4 text-white flex justify-between items-center">
        <h1 class="text-xl font-bold">Admin Panel (EMS)</h1>
        <div><span class="mr-4">Welcome, <%= user.username %>!</span><a href="/logout" class="py-2 px-4 bg-red-500 rounded hover:bg-red-600">Logout</a></div>
    </nav>

    <div class="container mx-auto p-8">
        <div class="w-full max-w-lg mx-auto bg-white p-8 rounded-lg shadow-md">
            <h2 class="text-2xl font-bold mb-6">Edit Student: <%= student.name %></h2>
            <form action="/admin/students/edit/<%= student.id %>" method="POST" class="space-y-4">
                <input type="hidden" name="id" value="<%= student.id %>">
                
                <div>
                    <label for="roll_no" class="block text-sm font-medium text-gray-700">Roll Number</label>
                    <input type="text" name="roll_no" id="roll_no" value="<%= student.roll_no %>" required class="w-full px-3 py-2 mt-1 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500">
                </div>
                <div>
                    <label for="name" class="block text-sm font-medium text-gray-700">Full Name</label>
                    <input type="text" name="name" id="name" value="<%= student.name %>" required class="w-full px-3 py-2 mt-1 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500">
                </div>
                <div>
                    <label for="course" class="block text-sm font-medium text-gray-700">Course</label>
                    <input type="text" name="course" id="course" value="<%= student.course %>" required class="w-full px-3 py-2 mt-1 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500">
                </div>
                <div>
                    <label for="semester" class="block text-sm font-medium text-gray-700">Semester</label>
                    <input type="number" name="semester" id="semester" value="<%= student.semester %>" required class="w-full px-3 py-2 mt-1 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500">
                </div>
                
                <div class="flex justify-end space-x-4">
                    <a href="/admin/students" class="py-2 px-4 bg-gray-300 text-gray-800 rounded hover:bg-gray-400">Cancel</a>
                    <button type="submit" class="py-2 px-4 bg-blue-600 text-white rounded hover:bg-blue-700">Update Student</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>