<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/css/output.css" rel="stylesheet">
    <title><%= title %></title>
</head>
<body class="bg-gray-100">
    <nav class="bg-blue-600 p-4 text-white flex justify-between items-center">
        <h1 class="text-xl font-bold">Admin Panel (EMS)</h1>
        <div><span class="mr-4">Welcome, <%= user.username %>!</span><a href="/logout" class="py-2 px-4 bg-red-500 rounded hover:bg-red-600">Logout</a></div>
    </nav>

    <div class="container mx-auto p-8">
        <div class="w-full max-w-lg mx-auto bg-white p-8 rounded-lg shadow-md">
            <h2 class="text-2xl font-bold mb-6">Edit Classroom</h2>
            <form action="/admin/classrooms/edit/<%= classroom.id %>" method="POST" class="space-y-4">
                <input type="hidden" name="id" value="<%= classroom.id %>">
                
                <div>
                    <label for="room_number" class="block text-sm font-medium text-gray-700">Room Number / Name</label>
                    <input type="text" name="room_number" id="room_number" value="<%= classroom.room_number %>" required class="w-full px-3 py-2 mt-1 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500">
                </div>
                <div>
                    <label for="capacity" class="block text-sm font-medium text-gray-700">Seating Capacity</label>
                    <input type="number" name="capacity" id="capacity" value="<%= classroom.capacity %>" required class="w-full px-3 py-2 mt-1 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500">
                </div>
                
                <div class="flex justify-end space-x-4">
                    <a href="/admin/classrooms" class="py-2 px-4 bg-gray-300 text-gray-800 rounded hover:bg-gray-400">Cancel</a>
                    <button type="submit" class="py-2 px-4 bg-blue-600 text-white rounded hover:bg-blue-700">Update Classroom</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>